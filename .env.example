DATABASE_URL=postgresql://cartiva:replace-with-local-password@127.0.0.1:55432/cartiva
POSTGRES_PASSWORD=replace-with-local-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:3000
# Stripe sandbox only: keys must start with sk_test_ / pk_test_. Live keys are refused.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --print-secret` locally, or the Dashboard endpoint when deployed.
STRIPE_WEBHOOK_SECRET=
# Public portfolio mode (deployments only): one-click demo accounts, daily reset,
# visitor details hidden in shared views. `npm run deploy:secrets` generates these.
DEMO_MODE=
DEMO_PASSWORD=
CRON_SECRET=
# Optional: database connections per server instance (defaults: 10 locally, 3 on Vercel).
DATABASE_POOL_MAX=
