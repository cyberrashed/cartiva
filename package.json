{
  "name": "cartiva",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "deploy:secrets": "node scripts/deploy-secrets.mjs",
    "db:up": "docker compose --env-file .env.local up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local --conditions=react-server --import tsx scripts/migrate.ts",
    "db:migrate:test": "node --env-file=.env.test.local --conditions=react-server --import tsx scripts/migrate.ts",
    "db:owner": "node --env-file=.env.local --conditions=react-server --import tsx scripts/bootstrap-owner.ts",
    "db:seed": "node --env-file=.env.local --conditions=react-server --import tsx scripts/seed-catalog.ts",
    "db:seed:test": "node --env-file=.env.test.local --conditions=react-server --import tsx scripts/seed-catalog.ts",
    "db:migrate:deploy": "node --conditions=react-server --import tsx scripts/migrate.ts",
    "db:seed:deploy": "node --conditions=react-server --import tsx scripts/seed-catalog.ts",
    "build:deploy": "npm run db:migrate:deploy && npm run db:seed:deploy && next build",
    "test:identity": "node --env-file=.env.test.local --conditions=react-server --import tsx --test tests/identity.integration.test.ts",
    "test:seller": "node --env-file=.env.test.local --conditions=react-server --import tsx --test tests/seller.integration.test.ts",
    "test:catalog": "node --env-file=.env.test.local --conditions=react-server --import tsx --test tests/catalog.integration.test.ts",
    "test:orders": "node --env-file=.env.test.local --conditions=react-server --import tsx --test tests/orders.integration.test.ts",
    "test:checkout-settings": "node --env-file=.env.test.local --conditions=react-server --import tsx --test tests/checkout-settings.integration.test.ts",
    "test:deploy": "node --env-file=.env.test.local --conditions=react-server --import tsx --test tests/deploy.integration.test.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.18",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "stripe": "23.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
